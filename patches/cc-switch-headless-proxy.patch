+//! `cc-switch-proxy proxy` — 在无桌面端的情况下管理 cc-switch DB 里的全局出站代理。
+//!
+//! 本地路由的出站代理来自两层：DB 里的 `global_proxy_url` 设置（本子命令读写，
+//! 与桌面端 `get/set_global_proxy_url` 同一键），以及环境变量兜底
+//! （`HTTP_PROXY` / `HTTPS_PROXY` / `ALL_PROXY`，reqwest 自动跟随）。守护进程
+//! 只在启动时读一次，改完需重启 cc-switch-proxy 才生效。
+//!
+//! 用法：
+//!   cc-switch-proxy proxy get     [--db PATH]
+//!   cc-switch-proxy proxy set     --url URL [--db PATH]
+//!   cc-switch-proxy proxy clear   [--db PATH]
+//!
+//! 所有命令打印一行 JSON（URL 不打码——这是调用方自己的 DB，非共享凭据）。
+
+use crate::database::Database;
+use crate::proxy::http_client;
+use serde_json::{json, Value};
+use std::collections::HashMap;
+use std::path::Path;
+
+pub const PROXY_HELP: &str = "\
+cc-switch-proxy proxy — 管理本地路由的全局出站代理（无桌面端）
+
+本地路由只有两个存在理由：① 转接口（上游非 Anthropic 协议时的协议转换）；
+② 加代理（出站需要 HTTP/HTTPS/SOCKS5 网络代理）。本子命令负责第 ② 类：
+读写 cc-switch DB 里的全局出站代理 URL，桌面端与 headless 共用同一份设置。
+
+用法:
+  cc-switch-proxy proxy <get|set|clear> [选项]
+
+选项:
+  --url <URL>   set 必填，支持 http / https / socks5 / socks5h
+  --db <PATH>   SQLite 数据库路径，默认 ~/.cc-switch/cc-switch.db
+
+注意:
+  - URL 也可以不写进库，直接用环境变量（HTTP_PROXY / HTTPS_PROXY / ALL_PROXY），
+    reqwest 会自动跟随；两种方式都配置时以 DB 设置优先。
+  - 守护进程只在启动时读取一次；写库后需重启 cc-switch-proxy 才生效。
+
+输出: 单行 JSON。
+";
+
+/// 分发 `proxy` 子命令（`args` 不含开头的 `proxy`）。
+pub fn run(args: &[String]) -> Result<(), String> {
+    let action = args.first().map(String::as_str).unwrap_or("get");
+    let rest: Vec<String> = args.get(1..).unwrap_or(&[]).to_vec();
+
+    match action {
+        "-h" | "--help" | "help" => {
+            println!("{PROXY_HELP}");
+            Ok(())
+        }
+        "get" => cmd_get(&rest),
+        "set" => cmd_set(&rest),
+        "clear" => cmd_clear(&rest),
+        other => Err(format!(
+            "未知的 proxy 子命令: {other}（用 `cc-switch-proxy proxy --help`）"
+        )),
+    }
+}
+
+fn cmd_get(args: &[String]) -> Result<(), String> {
+    let flags = parse_flags(args)?;
+    let db = open_db(&flags)?;
+    let url = db.get_global_proxy_url().map_err(|e| e.to_string())?;
+    emit(&json_out(url.as_deref()));
+    Ok(())
+}
+
+fn cmd_set(args: &[String]) -> Result<(), String> {
+    let flags = parse_flags(args)?;
+    let url = flags
+        .get("url")
+        .map(String::as_str)
+        .filter(|u| !u.trim().is_empty())
+        .ok_or_else(|| "set 需要 --url（http / https / socks5 / socks5h）".to_string())?
+        .trim()
+        .to_string();
+
+    // 与代理转发同一套校验（scheme 白名单 + client 可构建）；拒绝 `--url ''` 直接 clear。
+    http_client::validate_proxy(Some(&url)).map_err(|e| format!("无效的代理 URL: {e}"))?;
+
+    let db = open_db(&flags)?;
+    db.set_global_proxy_url(Some(&url))
+        .map_err(|e| e.to_string())?;
+    emit(&json_out(Some(&url)));
+    Ok(())
+}
+
+fn cmd_clear(args: &[String]) -> Result<(), String> {
+    let flags = parse_flags(args)?;
+    let db = open_db(&flags)?;
+    db.set_global_proxy_url(None).map_err(|e| e.to_string())?;
+    emit(&json_out(None));
+    Ok(())
+}
+
+/// 输出统一带一个生效提示：init 只在 daemon 启动时执行一次。
+fn json_out(url: Option<&str>) -> Value {
+    json!({
+        "global_proxy_url": url,
+        "effective": "重启 cc-switch-proxy 后生效（或由环境变量兜底）",
+    })
+}
+
+fn parse_flags(args: &[String]) -> Result<HashMap<String, String>, String> {
+    let mut flags = HashMap::new();
+    let mut iter = args.iter();
+    while let Some(arg) = iter.next() {
+        let Some(body) = arg.strip_prefix("--") else {
+            return Err(format!("意外的位置参数: {arg}（选项都以 -- 开头）"));
+        };
+        if let Some((key, value)) = body.split_once('=') {
+            flags.insert(key.to_string(), value.to_string());
+        } else if iter
+            .clone()
+            .next()
+            .is_some_and(|next| !next.starts_with("--"))
+        {
+            flags.insert(body.to_string(), iter.next().unwrap().clone());
+        } else {
+            flags.insert(body.to_string(), "true".to_string());
+        }
+    }
+    Ok(flags)
+}
+
+fn open_db(flags: &HashMap<String, String>) -> Result<Database, String> {
+    match flags.get("db") {
+        Some(path) => Database::init_at(Path::new(path)),
+        None => Database::init(),
+    }
+    .map_err(|e| format!("打开数据库失败: {e}"))
+}
+
+fn emit(value: &Value) {
+    println!(
+        "{}",
+        serde_json::to_string(value).unwrap_or_else(|_| "{}".to_string())
+    );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn args(items: &[&str]) -> Vec<String> {
+        items.iter().map(|s| s.to_string()).collect()
+    }
+
+    #[test]
+    fn run_dispatches_get_set_clear() {
+        // 未知的子命令必须报错，而不是静默走 get
+        assert!(run(&args(&["bogus"])).is_err());
+        assert!(run(&args(&["help"])).is_ok());
+    }
+
+    #[test]
+    fn set_requires_non_empty_url() {
+        let err = run(&args(&["set", "--db", "/tmp/x.db"])).unwrap_err();
+        assert!(err.contains("--url"), "got: {err}");
+        let err = run(&args(&["set", "--url", "  ", "--db", "/tmp/x.db"])).unwrap_err();
+        assert!(err.contains("--url"), "got: {err}");
+    }
+
+    #[test]
+    fn set_rejects_bad_scheme() {
+        let err = run(&args(&[
+            "set",
+            "--url",
+            "ftp://1.2.3.4",
+            "--db",
+            "/tmp/x.db",
+        ]))
+        .unwrap_err();
+        assert!(err.contains("无效的代理 URL"), "got: {err}");
+    }
+
+    #[test]
+    fn parse_flags_rejects_positional() {
+        assert!(parse_flags(&args(&["oops"])).is_err());
+    }
+}
