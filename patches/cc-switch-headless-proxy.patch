+//! 事件出口抽象（CORE-SPLIT-PLAN §4.1）。
+//!
+//! core 侧只认这个 trait；桌面端用 `TauriSink` 适配到 tauri 的 `Emitter`，
+//! headless 用 [`NoopSink`] 丢弃。托盘相关的两个钩子默认 no-op，只有 GUI 适配器覆写。
+
+use serde_json::Value;
+
+/// core 向外发射事件 / 通知托盘的唯一通道。
+pub trait EventSink: Send + Sync + 'static {
+    /// 通用事件发射（V1：mode/controller 也经 ProxyService::emit 发任意事件）。
+    fn emit(&self, event: &str, payload: Value);
+
+    /// 供应商切换后重建托盘菜单（failover 路径）。
+    fn refresh_tray(&self) {}
+
+    /// 代理 start/stop 后让托盘后台比对状态。
+    fn schedule_tray_status_check(&self) {}
+}
+
+/// 丢弃一切事件的 sink（headless / 测试默认值）。
+#[derive(Debug, Default, Clone, Copy)]
+pub struct NoopSink;
+
+impl EventSink for NoopSink {
+    fn emit(&self, _event: &str, _payload: Value) {}
+}
