+//! GUI 侧的 [`EventSink`](crate::events::EventSink) 适配器（CORE-SPLIT-PLAN §4.1）。
+//!
+//! core 永不认识 tauri；桌面端在 setup 里把 `TauriSink` 注入 `ProxyService`。
+
+use crate::events::EventSink;
+use serde_json::Value;
+
+/// 把事件转到 tauri 的事件总线，把托盘钩子转到 `tray` 模块。
+pub struct TauriSink(pub tauri::AppHandle);
+
+impl EventSink for TauriSink {
+    fn emit(&self, event: &str, payload: Value) {
+        use tauri::Emitter;
+        if let Err(e) = self.0.emit(event, payload) {
+            log::warn!("发送事件 {event} 失败: {e}");
+        }
+    }
+
+    fn refresh_tray(&self) {
+        crate::tray::refresh_tray_menu(&self.0);
+    }
+
+    fn schedule_tray_status_check(&self) {
+        crate::tray::schedule_tray_status_check(&self.0);
+    }
+}
