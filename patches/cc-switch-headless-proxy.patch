+fn cmd_set_current(args: &[String]) -> Result<(), String> {
+    let flags = parse_flags(args)?;
+    let db = open_db(&flags)?;
+    let app = app_of(&flags);
+    let id = flag(&flags, "id").ok_or("set-current 需要 --id")?;
+
+    db.set_current_provider(&app, id)
+        .map_err(|e| e.to_string())?;
