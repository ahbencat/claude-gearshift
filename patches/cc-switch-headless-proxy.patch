+//! 每模型传输覆盖（headless 补丁自有模块）。
+//!
+//! 数据存放在 `settings_config`（无类型 JSON）里，与 `env` 平级：
+//!
+//! ```json
+//! {
+//!   "env": { "ANTHROPIC_BASE_URL": "https://default", "ANTHROPIC_AUTH_TOKEN": "sk-default" },
+//!   "modelNodes":  [{ "name": "nodeA", "url": "https://a", "key": "sk-a" }],
+//!   "modelRoutes": { "mimo-v2.6": { "node": "nodeA", "format": "openai_chat" } }
+//! }
+//! ```
+//!
+//! 三种用法落在同一张表上：节点给全 url+key = 独立接入点；只给 key = 多 key 补充；
+//! 路由只给 format = 单纯换接口形态。节点省略的字段回落到供应商默认值。
+//!
+//! 模型表按键匹配前会剥掉 `[1m]` 上下文标记 —— forwarder 在任何按模型决策之前
+//! 就把 `[1m]` 剥掉了（`model_mapper::strip_one_m_suffix_for_upstream`），所以
+//! 键必须写剥后缀的名字；这里匹配时也做同样的剥离兜底。
+
+use serde_json::Value;
+
+use super::model_mapper::strip_one_m_suffix_for_upstream;
+use crate::provider::Provider;
+
+/// 每模型路由可用的协议值；与 `get_claude_api_format` 的取值域一致。
+pub const MODEL_ROUTE_FORMATS: [&str; 4] = [
+    "anthropic",
+    "openai_chat",
+    "openai_responses",
+    "gemini_native",
+];
+
+/// 每模型命中的传输覆盖；`None` 字段回落到供应商默认值。
+pub struct ModelRouteMatch {
+    /// 该模型使用的上游接口形态。
+    pub api_format: Option<String>,
+    /// 该模型使用的接入点（节点 url）。
+    pub base_url: Option<String>,
+    /// 该模型使用的凭据（节点 key）。
+    pub api_key: Option<String>,
+}
+
+/// 供应商是否声明了按模型路由表（`settings_config.modelRoutes`）。
+/// 表的存储键只在这里出现，模块外不要复述字符串。
+pub fn has_routes(provider: &Provider) -> bool {
+    provider.settings_config.get("modelRoutes").is_some()
+}
+
+/// 依据请求模型名在 `settings_config.modelRoutes` / `modelNodes` 里查覆盖。
+/// 未命中、表缺失或结构不合法时返回 `None`（走原有单协议路径）。
+pub fn lookup(provider: &Provider, model: Option<&str>) -> Option<ModelRouteMatch> {
+    let model = strip_one_m_suffix_for_upstream(model?);
+    let routes = provider.settings_config.get("modelRoutes")?.as_object()?;
+    let route = routes.get(model)?.as_object()?;
+
+    let nodes = provider
+        .settings_config
+        .get("modelNodes")
+        .and_then(Value::as_array);
+    let node = route.get("node").and_then(Value::as_str).and_then(|name| {
+        nodes.and_then(|list| {
+            list.iter().find_map(|entry| {
+                let entry = entry.as_object()?;
+                (entry.get("name").and_then(Value::as_str) == Some(name)).then_some(entry)
+            })
+        })
+    });
+
+    Some(ModelRouteMatch {
+        api_format: route
+            .get("format")
+            .and_then(Value::as_str)
+            .filter(|f| MODEL_ROUTE_FORMATS.contains(f))
+            .map(str::to_string),
+        base_url: node
+            .and_then(|n| n.get("url"))
+            .and_then(Value::as_str)
+            .map(str::trim)
+            .filter(|s| !s.is_empty())
+            .map(|s| s.trim_end_matches('/').to_string()),
+        api_key: node
+            .and_then(|n| n.get("key"))
+            .and_then(Value::as_str)
+            .map(str::trim)
+            .filter(|s| !s.is_empty())
+            .map(str::to_string),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn provider_with(config: Value) -> Provider {
+        Provider::with_id("p".to_string(), "P".to_string(), config, None)
+    }
+
+    fn config(nodes: Value, routes: Value) -> Value {
+        json!({
+            "env": {
+                "ANTHROPIC_BASE_URL": "https://default.example",
+                "ANTHROPIC_AUTH_TOKEN": "sk-default",
+            },
+            "modelNodes": nodes,
+            "modelRoutes": routes,
+        })
+    }
+
+    #[test]
+    fn lookup_returns_full_node_override() {
+        let provider = provider_with(config(
+            json!([{ "name": "a", "url": "https://a.example/", "key": "sk-a" }]),
+            json!({ "mimo-v2.6": { "node": "a", "format": "openai_chat" } }),
+        ));
+        let m = lookup(&provider, Some("mimo-v2.6")).unwrap();
+        assert_eq!(m.api_format.as_deref(), Some("openai_chat"));
+        assert_eq!(m.base_url.as_deref(), Some("https://a.example"));
+        assert_eq!(m.api_key.as_deref(), Some("sk-a"));
+    }
+
+    #[test]
+    fn lookup_strips_one_m_marker_before_matching() {
+        let provider = provider_with(config(
+            json!([{ "name": "a", "key": "sk-a" }]),
+            json!({ "hy4-preview": { "node": "a" } }),
+        ));
+        let m = lookup(&provider, Some("hy4-preview[1M]")).unwrap();
+        assert!(m.api_format.is_none());
+        assert!(m.base_url.is_none());
+        assert_eq!(m.api_key.as_deref(), Some("sk-a"));
+    }
+
+    #[test]
+    fn lookup_supports_format_only_route() {
+        let provider = provider_with(config(
+            json!([]),
+            json!({ "deepseek-v4": { "format": "openai_responses" } }),
+        ));
+        let m = lookup(&provider, Some("deepseek-v4")).unwrap();
+        assert_eq!(m.api_format.as_deref(), Some("openai_responses"));
+        assert!(m.base_url.is_none());
+        assert!(m.api_key.is_none());
+    }
+
+    #[test]
+    fn lookup_ignores_unknown_format_and_blank_fields() {
+        let provider = provider_with(config(
+            json!([{ "name": "a", "url": "  ", "key": "" }]),
+            json!({ "m": { "node": "a", "format": "ftp" } }),
+        ));
+        let m = lookup(&provider, Some("m")).unwrap();
+        assert!(m.api_format.is_none());
+        assert!(m.base_url.is_none());
+        assert!(m.api_key.is_none());
+    }
+
+    #[test]
+    fn lookup_misses_without_tables_or_model() {
+        let bare = provider_with(json!({ "env": {} }));
+        assert!(lookup(&bare, Some("m")).is_none());
+        let provider = provider_with(config(json!([]), json!({ "other": {} })));
+        assert!(lookup(&provider, Some("m")).is_none());
+        assert!(lookup(&provider, None).is_none());
+    }
+}
