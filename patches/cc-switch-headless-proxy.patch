diff --git a/src-tauri/core/src/runtime.rs b/src-tauri/core/src/runtime.rs
new file mode 100644
index 00000000..8d6eec9a
--- /dev/null
+++ b/src-tauri/core/src/runtime.rs
@@ -0,0 +1,46 @@
+//! 全局异步运行时（CORE-SPLIT-PLAN §4.6）。
+//!
+//! 逐字镜像桌面端的 async_runtime 模块：它本身就是全局 tokio Runtime 的包装，
+//! `spawn`/`spawn_blocking`/`block_on` 在任意线程（含别的 runtime 的工作线程、
+//! 同步 DAO 写路径）都合法。裸换 `tokio::spawn` / `Handle::block_on` 会在
+//! 无当前 runtime 或嵌套 runtime 处 panic（V7）。拆分后 core 自带本模块，
+//! headless/测试零接线（懒建全局）。
+
+use std::future::Future;
+use std::sync::OnceLock;
+
+static RT: OnceLock<tokio::runtime::Runtime> = OnceLock::new();
+
+fn rt() -> &'static tokio::runtime::Runtime {
+    RT.get_or_init(|| tokio::runtime::Runtime::new().expect("构建全局异步运行时失败"))
+}
+
+/// 把任务调度到全局 runtime（镜像 async_runtime::spawn）。
+pub fn spawn<F>(task: F) -> tokio::task::JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    rt().spawn(task)
+}
+
+/// 在专用阻塞线程池执行（镜像 async_runtime::spawn_blocking）。
+pub fn spawn_blocking<T, F>(func: F) -> tokio::task::JoinHandle<T>
+where
+    F: FnOnce() -> T + Send + 'static,
+    T: Send + 'static,
+{
+    rt().spawn_blocking(func)
+}
+
+/// 在当前线程把 future 跑完（镜像 async_runtime::block_on）。
+pub fn block_on<F: Future>(task: F) -> F::Output {
+    rt().block_on(task)
+}
+
+/// 取全局 runtime 句柄（镜像 async_runtime::handle）；
+/// 测试里 `handle.block_on(...)` 与 [`block_on`] 语义一致。
+#[cfg(test)]
+pub fn handle() -> tokio::runtime::Handle {
+    rt().handle().clone()
+}
