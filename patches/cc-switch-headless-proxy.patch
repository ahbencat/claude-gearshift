+        let routes = r#"{"mimo-v2.6":{"node":"a","format":"openai_chat"}}"#;
+        let mut flags = HashMap::new();
+        flags.insert("model-nodes".to_string(), nodes.to_string());
+        flags.insert("model-routes".to_string(), routes.to_string());
+
+        let mut config = Map::new();
+        apply_model_flag(&mut config, &flags, "model-nodes", "modelNodes").unwrap();
+        apply_model_flag(&mut config, &flags, "model-routes", "modelRoutes").unwrap();
+        assert_eq!(
+            config.get("modelNodes").unwrap(),
+            &serde_json::from_str::<Value>(nodes).unwrap()
+        );
+        assert_eq!(
+            config.get("modelRoutes").unwrap(),
+            &serde_json::from_str::<Value>(routes).unwrap()
+        );
