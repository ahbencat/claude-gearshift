+//! 故障转移切换模块
+//!
+//! 处理故障转移成功后的供应商切换逻辑，包括：
+//! - 去重控制（避免多个请求同时触发）
+//! - 托盘菜单更新
+//! - 前端事件发射
+
+use crate::error::AppError;
+use std::collections::HashSet;
+use std::sync::Arc;
+use tokio::sync::RwLock;
+
+/// 故障转移切换管理器
+///
+/// 负责处理故障转移成功后的供应商切换，确保 UI 能够直观反映当前使用的供应商。
+#[derive(Clone, Default)]
+pub struct FailoverSwitchManager {
+    /// 正在处理中的切换（key = "app_type:provider_id"）
+    pending_switches: Arc<RwLock<HashSet<String>>>,
+}
+
+impl FailoverSwitchManager {
+    pub fn new() -> Self {
+        Self {
+            pending_switches: Arc::new(RwLock::new(HashSet::new())),
+        }
+    }
+
+    /// 尝试执行故障转移切换
+    ///
+    /// 如果相同的切换已在进行中，则跳过；否则执行切换逻辑。
+    ///
+    /// # Returns
+    /// - `Ok(true)` - 切换成功执行
+    /// - `Ok(false)` - 切换已在进行中，跳过
+    /// - `Err(e)` - 切换过程中发生错误
+    pub async fn try_switch(
+        &self,
+        ctx: &super::context::ProxyContext,
+        app_type: &str,
+        provider_id: &str,
+        provider_name: &str,
+    ) -> Result<bool, AppError> {
+        let switch_key = format!("{app_type}:{provider_id}");
+
+        // 去重检查：如果相同切换已在进行中，跳过
+        {
+            let mut pending = self.pending_switches.write().await;
+            if pending.contains(&switch_key) {
+                log::debug!("[Failover] 切换已在进行中，跳过: {app_type} -> {provider_id}");
+                return Ok(false);
+            }
+            pending.insert(switch_key.clone());
+        }
+
+        // 执行切换（确保最后清理 pending 标记）
+        let result = self
+            .do_switch(ctx, app_type, provider_id, provider_name)
+            .await;
+
+        // 清理 pending 标记
+        {
+            let mut pending = self.pending_switches.write().await;
+            pending.remove(&switch_key);
+        }
+
+        result
+    }
+
+    async fn do_switch(
+        &self,
+        ctx: &super::context::ProxyContext,
+        app_type: &str,
+        provider_id: &str,
+        provider_name: &str,
+    ) -> Result<bool, AppError> {
+        // 只有处于代理模式的应用才允许执行故障转移切换
+        let Ok(app_enum) = app_type.parse::<crate::app_config::AppType>() else {
+            return Ok(false);
+        };
+        if !crate::mode::current::is_proxy(&app_enum) {
+            log::debug!("[Failover] {app_type} 不在路由模式，跳过切换");
+            return Ok(false);
+        }
+
+        log::info!("[FO-001] 切换: {app_type} → {provider_name}");
+
+        // C2 修复：headless（app_state=Some 但无 GUI）现在也真正记录路由；
+        // 测试/未绑定场景 app_state=None 时跳过记录（与旧 app_handle=None 一致）。
+        let mut switched = false;
+
+        if let Some(app_state) = &ctx.app_state {
+            // 只换代理的路由，不写客户端文件。
+            switched = crate::mode::controller::record_failover_route(
+                app_state.as_ref(),
+                &app_enum,
+                provider_id,
+            )
+            .await
+            .map_err(AppError::Message)?;
+
+            if !switched {
+                return Ok(false);
+            }
+
+            // Linux 重建原生菜单，其它平台通知托盘面板（不挂原生菜单）
+            ctx.sink.refresh_tray();
+        }
+
+        // 发射事件到前端（headless 的 NoopSink 丢弃）
+        ctx.sink.emit(
+            "provider-switched",
+            serde_json::json!({
+                "appType": app_type,
+                "providerId": provider_id,
+                "source": "failover"  // 标识来源是故障转移
+            }),
+        );
+
+        Ok(switched)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    //! C2 回归：`ProxyContext.app_state = Some` 时 headless 也真正记录 failover 路由；
+    //! `None` 时跳过记录（与拆分前 `app_handle: None` 行为一致）。
+    use super::*;
+    use crate::app_config::AppType;
+    use crate::database::Database;
+    use crate::mode::controller::{enter, exit};
+    use crate::mode::current::{provider_for, Purpose};
+    use crate::provider::Provider;
+    use crate::proxy::context::ProxyContext;
+    use crate::proxy::types::ProxyConfig;
+    use crate::store::AppState;
+    use serial_test::serial;
+    use std::ffi::OsString;
+    use std::fs;
+    use tempfile::TempDir;
+
+    struct Home {
+        /// 保活临时目录；Drop 先恢复环境再随字段销毁。
+        _dir: TempDir,
+        saved: Vec<(&'static str, Option<OsString>)>,
+    }
+
+    impl Home {
+        fn new() -> Self {
+            let dir = TempDir::new().expect("temp home");
+            let saved = ["HOME", "USERPROFILE", "CC_SWITCH_TEST_HOME"]
+                .into_iter()
+                .map(|key| {
+                    let old = std::env::var_os(key);
+                    std::env::set_var(key, dir.path());
+                    (key, old)
+                })
+                .collect();
+            crate::settings::reload_settings().expect("reload settings");
+            Self { _dir: dir, saved }
+        }
+    }
+
+    impl Drop for Home {
+        fn drop(&mut self) {
+            for (key, old) in self.saved.drain(..) {
+                match old {
+                    Some(value) => std::env::set_var(key, value),
+                    None => std::env::remove_var(key),
+                }
+            }
+            let _ = crate::settings::reload_settings();
+        }
+    }
+
+    const USER_SETTINGS: &str = r#"{
+  "hooks": {
+    "Stop": []
+  },
+  "env": {
+    "ANTHROPIC_BASE_URL": "https://a.example",
+    "ANTHROPIC_AUTH_TOKEN": "sk-a",
+    "ANTHROPIC_MODEL": "claude-sonnet-4-6",
+    "DISABLE_TELEMETRY": "1"
+  },
+  "permissions": {
+    "allow": [
+      "Bash"
+    ]
+  }
+}
+"#;
+
+    fn claude(id: &str, url: &str) -> Provider {
+        Provider::with_id(
+            id.to_string(),
+            id.to_uppercase(),
+            serde_json::json!({
+                "env": {
+                    "ANTHROPIC_BASE_URL": url,
+                    "ANTHROPIC_AUTH_TOKEN": format!("sk-{id}"),
+                    "ANTHROPIC_MODEL": "claude-sonnet-4-6"
+                }
+            }),
+            None,
+        )
+    }
+
+    async fn state_with(rows: &[Provider], current: &str) -> AppState {
+        let db = Arc::new(Database::memory().expect("memory db"));
+        for row in rows {
+            db.save_provider(AppType::Claude.as_str(), row)
+                .expect("save provider");
+        }
+        db.set_current_provider(AppType::Claude.as_str(), current)
+            .expect("set current");
+        crate::settings::set_current_provider(&AppType::Claude, Some(current))
+            .expect("local current");
+        db.update_proxy_config(ProxyConfig {
+            listen_port: 0,
+            ..Default::default()
+        })
+        .await
+        .expect("ephemeral port");
+        AppState::new(db)
+    }
+
+    fn seed_settings() {
+        let path = crate::config::get_claude_settings_path();
+        fs::create_dir_all(path.parent().unwrap()).unwrap();
+        fs::write(path, USER_SETTINGS).unwrap();
+    }
+
+    fn in_use(state: &AppState) -> Option<String> {
+        provider_for(&state.db, &AppType::Claude, Purpose::InUse).unwrap()
+    }
+
+    #[tokio::test]
+    #[serial]
+    async fn headless_context_records_failover_route() {
+        let _home = Home::new();
+        seed_settings();
+        let state = Arc::new(
+            state_with(
+                &[
+                    claude("a", "https://a.example"),
+                    claude("b", "https://b.example"),
+                ],
+                "a",
+            )
+            .await,
+        );
+        enter(&state, &AppType::Claude, false).await.expect("enter");
+        assert_eq!(in_use(&state).as_deref(), Some("a"));
+
+        // app_state = None：跳过记录（旧行为），路由停在 a。
+        let manager = FailoverSwitchManager::new();
+        let ctx_none = ProxyContext::default();
+        let switched = manager
+            .try_switch(&ctx_none, "claude", "b", "B")
+            .await
+            .expect("switch without app_state");
+        assert!(!switched);
+        assert_eq!(in_use(&state).as_deref(), Some("a"));
+
+        // app_state = Some：C2 修复——记录生效，路由换到 b。
+        let ctx = ProxyContext {
+            app_state: Some(state.clone()),
+            ..Default::default()
+        };
+        let switched = manager
+            .try_switch(&ctx, "claude", "b", "B")
+            .await
+            .expect("switch with app_state");
+        assert!(switched);
+        assert_eq!(in_use(&state).as_deref(), Some("b"));
+
+        exit(&state, &AppType::Claude).await.expect("exit");
+    }
+}
