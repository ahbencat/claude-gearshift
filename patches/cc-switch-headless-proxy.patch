+[package]
+name = "cc-switch-core"
+version = "4.0.33"
+description = "Tauri-free core engine for CC Switch (proxy, DAO, provider configs)"
+authors = ["Jason Young"]
+license = "MIT"
+repository = "https://github.com/farion1231/cc-switch"
+edition = "2021"
+rust-version = "1.85.0"
+publish = false
+
+# Tauri-free 依赖子集：本 crate 不得引入 tauri 系（门禁 cargo tree -i tauri）。
+# 版本与 features 逐字对齐 ../Cargo.toml，避免双版本。
+
+[lib]
+name = "cc_switch_core"
+# 只出 rlib（与主 crate 一致，不带 staticlib/cdylib）。
+crate-type = ["rlib"]
+doctest = false
+
+[features]
+default = []
+
+[dependencies]
+serde_json = { version = "1.0", features = ["preserve_order"] }
+serde = { version = "1.0", features = ["derive"] }
+log = { version = "0.4", features = ["std"] }
+chrono = { version = "0.4", features = ["serde"] }
+dirs = "5.0"
+toml = "0.8"
+toml_edit = "0.22"
+reqwest = { version = "0.12", features = ["rustls-tls", "json", "stream", "socks"] }
+flate2 = "1"
+brotli = "7"
+zstd = "0.13"
+tokio = { version = "1", features = ["macros", "rt-multi-thread", "time", "sync", "net", "process", "signal"] }
+futures = "0.3"
+# Keep legacy SSE support alongside Streamable HTTP; newer SDKs removed SSE.
+rmcp = { version = "0.8.5", features = ["client", "transport-async-rw", "transport-sse-client-reqwest", "transport-streamable-http-client-reqwest"] }
+process-wrap = { version = "8.2", features = ["tokio1"] }
+async-stream = "0.3"
+bytes = "1.5"
+prost = "0.14"
+axum = "0.7"
+tower = "0.4"
+hyper = { version = "1.0", features = ["full"] }
+hyper-util = { version = "0.1", features = ["tokio", "http1", "client-legacy"] }
+hyper-rustls = { version = "0.27", features = ["http1", "tls12", "ring", "webpki-tokio"] }
+http = "1"
+http-body-util = "0.1"
+httparse = "1"
+tokio-rustls = "0.26"
+rustls = "0.23"
+webpki-roots = "0.26"
+rustls-native-certs = "0.8"
+regex = "1.10"
+aho-corasick = "1.1"
+rquickjs = { version = "0.8", features = ["array-buffer", "classes"] }
+thiserror = "2.0"
+anyhow = "1.0"
+zip = "2.2"
+serde_yaml = "0.9"
+tempfile = "3"
+url = "2.5"
+once_cell = "1.21.3"
+base64 = "0.22"
+# 校验自定义供应商图标（services/provider/icon）
+png = "0.18"
+rusqlite = { version = "0.31", features = ["bundled", "backup", "hooks"] }
+indexmap = { version = "2", features = ["serde"] }
+rust_decimal = "1.33"
+uuid = { version = "1.11", features = ["v4"] }
+sha2 = "0.10"
+hmac = "0.12"
+subtle = "2.6"
+json5 = "0.4"
+json-five = "0.3.1"
+sys-locale = "0.3"
+
+[target.'cfg(not(target_os = "windows"))'.dependencies]
+libc = "0.2"
+
+[target.'cfg(target_os = "windows")'.dependencies]
+winreg = "0.52"
+windows = "0.61"
+windows-sys = { version = "0.61", features = [
+    "Win32_Foundation",
+    "Win32_Globalization",
+    "Win32_Security_Credentials",
+    "Win32_Storage_FileSystem",
+    "Win32_Graphics_Gdi",
+    "Win32_System_Threading",
+    "Win32_UI_Shell",
+    "Win32_UI_HiDpi",
+    "Win32_UI_WindowsAndMessaging",
+] }
+
+[target.'cfg(all(target_os = "windows", target_arch = "aarch64"))'.dependencies]
+rquickjs = { version = "0.8", features = ["bindgen"] }
+
+[dev-dependencies]
+serial_test = "3"
+tempfile = "3"
+tokio = { version = "1", features = ["test-util"] }
