+            // 声明了 format 就按它走；未命中回落到供应商级单协议判定。
+            if let Some(model) = body.get("model").and_then(|value| value.as_str()) {
+                if let Some(format) = super::model_route::lookup(provider, Some(model))
+                    .and_then(|matched| matched.api_format)
+                {
+                    return format;
+                }
+            }
             return super::providers::get_claude_api_format(provider).to_string();
         }
 
