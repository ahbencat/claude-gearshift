+//! 代理引擎的注入上下文（CORE-SPLIT-PLAN §4.2）。
+//!
+//! `ProxyServer` / `RequestForwarder` / `FailoverSwitchManager` 不再持有
+//! `Option<AppHandle>`（GUI 句柄），改为持有本结构：
+//!
+//! - `sink`：事件出口（headless = [`NoopSink`](crate::events::NoopSink)）；
+//! - `oauth`：三个 OAuth manager 的可选注入。**headless 全为 None**，
+//!   forwarder 的 Copilot/Codex/xAI 分支照旧走 `AuthError` else 臂，
+//!   与拆分前 `app_handle: None` 的行为逐字一致（OAuth 不是本次拆分的目标）；
+//! - `app_state`：failover 路由记录用。测试可 None（跳过记录，同旧行为）；
+//!   headless 现在会注入——这正是 C2 修复（见 failover_switch）。
+
+use super::providers::codex_oauth_auth::CodexOAuthManager;
+use super::providers::copilot_auth::CopilotAuthManager;
+use super::providers::xai_oauth_auth::XaiOAuthManager;
+use crate::events::{EventSink, NoopSink};
+use crate::store::AppState;
+use std::sync::Arc;
+use tokio::sync::RwLock;
+
+/// 三个动态 OAuth manager。GUI 侧从 `app.manage(...)` 的同一实例注入；
+/// headless 全 None。
+#[derive(Clone, Default)]
+pub struct OAuthManagers {
+    pub codex: Option<Arc<CodexOAuthManager>>,
+    pub copilot: Option<Arc<RwLock<CopilotAuthManager>>>,
+    pub xai: Option<Arc<RwLock<XaiOAuthManager>>>,
+}
+
+/// 代理引擎每请求/每服务共享的上下文。`Clone` 便宜（全 Arc / None）。
+#[derive(Clone)]
+pub struct ProxyContext {
+    pub sink: Arc<dyn EventSink>,
+    pub oauth: OAuthManagers,
+    /// failover 路由记录的目标。强环由 `ProxyService` 用 `Weak` 绑定化解
+    /// （见 §4.2）；这里只是 server 运行期间的强引用。
+    pub app_state: Option<Arc<AppState>>,
+}
+
+impl Default for ProxyContext {
+    fn default() -> Self {
+        Self {
+            sink: Arc::new(NoopSink),
+            oauth: OAuthManagers::default(),
+            app_state: None,
+        }
+    }
+}
