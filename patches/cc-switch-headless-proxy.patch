diff --git a/src-tauri/core/src/bin/cc-switch-proxy.rs b/src-tauri/core/src/bin/cc-switch-proxy.rs
new file mode 100644
index 00000000..a3f226bd
--- /dev/null
+++ b/src-tauri/core/src/bin/cc-switch-proxy.rs
@@ -0,0 +1,45 @@
+//! `cc-switch-proxy` — CC Switch 本地路由的无界面入口。
+//!
+//! 只做参数解析和运行时搭建，真正的逻辑在 `cc_switch_core::headless`。
+//! 这样 headless 守护进程与桌面端共用同一套 proxy 引擎和数据库。
+
+use cc_switch_core::headless::{parse_args, run, HeadlessCommand, HELP};
+
+#[tokio::main]
+async fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+
+    // `provider` 子命令走同步的 DAO 路径，不启动代理服务。
+    if args.first().map(String::as_str) == Some("provider") {
+        if let Err(e) = cc_switch_core::provider_cli::run(&args[1..]) {
+            eprintln!("cc-switch-proxy: {e}");
+            std::process::exit(1);
+        }
+        return;
+    }
+
+    // `proxy` 子命令同样只读写 DAO（全局出站代理），不启动代理服务。
+    if args.first().map(String::as_str) == Some("proxy") {
+        if let Err(e) = cc_switch_core::proxy_cli::run(&args[1..]) {
+            eprintln!("cc-switch-proxy: {e}");
+            std::process::exit(1);
+        }
+        return;
+    }
+
+    match parse_args(args) {
+        Ok(HeadlessCommand::Help) => {
+            println!("{HELP}");
+        }
+        Ok(HeadlessCommand::Run(opts)) => {
+            if let Err(e) = run(opts).await {
+                eprintln!("cc-switch-proxy: {e}");
+                std::process::exit(1);
+            }
+        }
+        Err(message) => {
+            eprintln!("cc-switch-proxy: {message}");
+            std::process::exit(2);
+        }
+    }
+}
