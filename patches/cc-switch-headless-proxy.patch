diff --git a/src-tauri/src/headless.rs b/src-tauri/src/headless.rs
new file mode 100644
index 00000000..4e8d4a60
--- /dev/null
+++ b/src-tauri/src/headless.rs
@@ -0,0 +1,247 @@
+//! 无界面的本地路由守护进程（headless）。
+//!
+//! 复用桌面端同一套 `proxy` 引擎，但不启动 Tauri 窗口/托盘，适合在
+//! Linux 服务器上作为 systemd 服务运行，供 `linux_switch` 之类的工具
+//! 按需拉起/停止，替代 LiteLLM。
+//!
+//! 供应商与模型来自 CC Switch 的 SQLite 库（默认
+//! `~/.cc-switch/cc-switch.db`，可用 `--db` 指向别的库）。请先用桌面端
+//! CC Switch 配置好供应商；无界面进程不做 Live 配置改写，只提供转发服务。
+//!
+//! 注意：本二进制与桌面端同源，仍会链接 Tauri/WebKitGTK 运行库，因此
+//! 无界面运行也需要安装 WebKitGTK 运行时依赖（见仓库 README 的 Linux 前置依赖）。
+
+use crate::database::Database;
+use crate::proxy::server::ProxyServer;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+/// `--help` 文本。
+pub const HELP: &str = "\
+cc-switch-proxy — CC Switch 本地路由的无界面守护进程
+
+用法:
+  cc-switch-proxy [选项]
+
+选项:
+  --host <ADDR>   监听地址（默认取数据库中的设置，通常 127.0.0.1）
+  --port <PORT>   监听端口（默认取数据库中的设置，通常 15721）
+  --db <PATH>     使用指定的 SQLite 数据库（默认 ~/.cc-switch/cc-switch.db）
+  -h, --help      显示本帮助
+
+子命令:
+  provider ...    管理数据库里的供应商（list/add/update/delete/set-current/import）
+                  见 `cc-switch-proxy provider --help`
+  proxy ...       管理全局出站代理（get/set/clear），本地路由“加代理”场景入口
+                  见 `cc-switch-proxy proxy --help`
+
+供应商与模型来自 CC Switch 的数据库；请先用桌面端 CC Switch 配置好供应商。
+环境变量 RUST_LOG 控制日志级别（off/error/warn/info/debug/trace），默认 info。
+";
+
+/// 命令行解析结果。
+#[derive(Debug, PartialEq, Eq)]
+pub enum HeadlessCommand {
+    Run(HeadlessOptions),
+    Help,
+}
+
+/// headless 守护进程的运行参数。字段为 `None` 时回退到数据库中的配置。
+#[derive(Debug, Default, PartialEq, Eq)]
+pub struct HeadlessOptions {
+    pub host: Option<String>,
+    pub port: Option<u16>,
+    pub db_path: Option<PathBuf>,
+}
+
+/// 解析命令行参数（不含程序名本身）。未知参数返回 `Err`。
+pub fn parse_args<I>(args: I) -> Result<HeadlessCommand, String>
+where
+    I: IntoIterator,
+    I::Item: Into<String>,
+{
+    let mut opts = HeadlessOptions::default();
+    let mut iter = args.into_iter().map(Into::into);
+
+    while let Some(arg) = iter.next() {
+        match arg.as_str() {
+            "-h" | "--help" => return Ok(HeadlessCommand::Help),
+            "--host" => {
+                opts.host = Some(iter.next().ok_or("--host 需要一个参数")?);
+            }
+            "--port" => {
+                let value = iter.next().ok_or("--port 需要一个参数")?;
+                let port: u16 = value
+                    .parse()
+                    .map_err(|_| format!("无效的端口: {value}（应为 0-65535）"))?;
+                opts.port = Some(port);
+            }
+            "--db" => {
+                let value = iter.next().ok_or("--db 需要一个参数")?;
+                opts.db_path = Some(PathBuf::from(value));
+            }
+            other => return Err(format!("未知参数: {other}（用 --help 查看用法）")),
+        }
+    }
+
+    Ok(HeadlessCommand::Run(opts))
+}
+
+/// 启动本地路由并阻塞，直到收到 SIGINT / SIGTERM 后优雅停止。
+pub async fn run(opts: HeadlessOptions) -> Result<(), String> {
+    install_logger();
+    crate::panic_hook::setup_panic_hook();
+
+    let db = match opts.db_path.as_deref() {
+        Some(path) => Database::init_at(path),
+        None => Database::init(),
+    }
+    .map_err(|e| format!("打开数据库失败: {e}"))?;
+    let db = Arc::new(db);
+
+    // 与桌面端启动一致：初始化全局 HTTP 客户端（可能配置了上游代理）。
+    let upstream = db.get_global_proxy_url().ok().flatten();
+    crate::proxy::http_client::init(upstream.as_deref())
+        .map_err(|e| format!("初始化 HTTP 客户端失败: {e}"))?;
+
+    let mut config = db
+        .get_proxy_config()
+        .await
+        .map_err(|e| format!("读取代理配置失败: {e}"))?;
+    if let Some(host) = opts.host {
+        config.listen_address = host;
+    }
+    if let Some(port) = opts.port {
+        config.listen_port = port;
+    }
+
+    // 无界面：没有 Tauri AppHandle，故障转移 UI 事件与 Copilot/Codex/xAI
+    // OAuth 状态不可用，其余转发逻辑不受影响。
+    let server = ProxyServer::new(config, db.clone(), None);
+    let info = server
+        .start()
+        .await
+        .map_err(|e| format!("启动本地路由失败: {e}"))?;
+    log::info!("本地路由已启动: http://{}:{}", info.address, info.port);
+
+    wait_for_shutdown().await;
+
+    log::info!("收到退出信号，正在停止本地路由…");
+    if let Err(e) = server.stop().await {
+        log::warn!("停止本地路由时出错: {e}");
+    }
+    log::info!("本地路由已停止");
+    Ok(())
+}
+
+#[cfg(unix)]
+async fn wait_for_shutdown() {
+    use tokio::signal::unix::{signal, SignalKind};
+
+    let mut term = match signal(SignalKind::terminate()) {
+        Ok(sig) => sig,
+        Err(e) => {
+            log::warn!("无法监听 SIGTERM: {e}，改用 Ctrl-C");
+            let _ = tokio::signal::ctrl_c().await;
+            return;
+        }
+    };
+    let mut int = match signal(SignalKind::interrupt()) {
+        Ok(sig) => sig,
+        Err(e) => {
+            log::warn!("无法监听 SIGINT: {e}，改用 Ctrl-C");
+            let _ = tokio::signal::ctrl_c().await;
+            return;
+        }
+    };
+
+    tokio::select! {
+        _ = term.recv() => log::info!("收到 SIGTERM"),
+        _ = int.recv() => log::info!("收到 SIGINT"),
+    }
+}
+
+#[cfg(not(unix))]
+async fn wait_for_shutdown() {
+    let _ = tokio::signal::ctrl_c().await;
+}
+
+/// 安装一个把日志写到 stderr 的最小 logger。
+///
+/// 桌面端用的是 `tauri-plugin-log`（依赖 AppHandle），无界面进程用不了，
+/// 这里不再引入额外依赖。`RUST_LOG` 接受 log crate 的级别名。
+fn install_logger() {
+    use std::sync::Once;
+
+    static INIT: Once = Once::new();
+    INIT.call_once(|| {
+        let level = std::env::var("RUST_LOG")
+            .ok()
+            .and_then(|value| value.parse::<log::LevelFilter>().ok())
+            .unwrap_or(log::LevelFilter::Info);
+
+        let _ = log::set_boxed_logger(Box::new(StderrLogger));
+        log::set_max_level(level);
+    });
+}
+
+struct StderrLogger;
+
+impl log::Log for StderrLogger {
+    fn enabled(&self, metadata: &log::Metadata) -> bool {
+        metadata.level() <= log::max_level()
+    }
+
+    fn log(&self, record: &log::Record) {
+        if self.enabled(record.metadata()) {
+            eprintln!("[{}] {}", record.level(), record.args());
+        }
+    }
+
+    fn flush(&self) {}
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parse_args_defaults_to_database_config() {
+        assert_eq!(
+            parse_args(Vec::<String>::new()).unwrap(),
+            HeadlessCommand::Run(HeadlessOptions::default())
+        );
+    }
+
+    #[test]
+    fn parse_args_reads_host_port_and_db() {
+        let args = vec![
+            "--host".to_string(),
+            "0.0.0.0".to_string(),
+            "--port".to_string(),
+            "9301".to_string(),
+            "--db".to_string(),
+            "/tmp/x.db".to_string(),
+        ];
+        assert_eq!(
+            parse_args(args).unwrap(),
+            HeadlessCommand::Run(HeadlessOptions {
+                host: Some("0.0.0.0".to_string()),
+                port: Some(9301),
+                db_path: Some(PathBuf::from("/tmp/x.db")),
+            })
+        );
+    }
+
+    #[test]
+    fn parse_args_help_wins() {
+        assert_eq!(parse_args(["--help"]).unwrap(), HeadlessCommand::Help);
+    }
+
+    #[test]
+    fn parse_args_rejects_unknown_and_missing_values() {
+        assert!(parse_args(["--nope"]).is_err());
+        assert!(parse_args(["--port"]).is_err());
+        assert!(parse_args(["--port", "70000"]).is_err());
+    }
+}
