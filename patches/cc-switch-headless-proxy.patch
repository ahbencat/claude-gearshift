-    if tool == "opencode"
-        && path
-            .file_name()
-            .and_then(|name| name.to_str())
-            .is_some_and(|name| name.eq_ignore_ascii_case("opencode.exe"))
-    {
-        if let Some(parent) = path.parent() {
-            let sidecar = parent.join("opencode-cli.exe");
