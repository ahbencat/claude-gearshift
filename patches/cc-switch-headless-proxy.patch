+
+fn cmd_import(args: &[String]) -> Result<(), String> {
+    let flags = parse_flags(args)?;
+    let db = open_db(&flags)?;
+    let app = app_of(&flags);
+    let dir = flag(&flags, "dir").ok_or("import 需要 --dir")?;
+
+    let mut imported: Vec<String> = Vec::new();
+    let mut errors: Vec<String> = Vec::new();
+
+    let entries = std::fs::read_dir(dir).map_err(|e| format!("读取目录失败 {dir}: {e}"))?;
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if path.extension().and_then(|s| s.to_str()) != Some("json") {
+            continue;
+        }
+        let Some(stem) = path.file_stem().and_then(|s| s.to_str()).map(String::from) else {
+            continue;
+        };
+        if stem == "sample" {
+            continue;
+        }
+        let text = match std::fs::read_to_string(&path) {
+            Ok(text) => text,
+            Err(e) => {
+                errors.push(format!("{stem}: 读取失败: {e}"));
+                continue;
+            }
+        };
+        let value: Value = match serde_json::from_str(&text) {
+            Ok(value) => value,
+            Err(e) => {
+                errors.push(format!("{stem}: JSON 解析失败: {e}"));
+                continue;
+            }
+        };
+        // Claude 供应商就是 {"env": {...}}；如果文件本身就是 env 块，包一层。
+        let settings_config = if value.get("env").is_some() {
+            value
+        } else {
+            json!({ "env": value })
+        };
+        let provider = Provider::with_id(stem.clone(), stem.clone(), settings_config, None);
+        match db.save_provider(&app, &provider) {
+            Ok(()) => imported.push(stem),
+            Err(e) => errors.push(format!("{stem}: {e}")),
+        }
+    }
+
+    if has(&flags, "set-current") {
+        if let Some(first) = imported.first() {
+            db.set_current_provider(&app, first)
+                .map_err(|e| e.to_string())?;
+        }
+    }
+
+    emit(&json!({
+        "ok": errors.is_empty(),
+        "app": app,
+        "imported": imported,
+        "errors": errors,
+    }));
+    Ok(())
+}
+
+// --- 辅助 ---
+
+fn parse_flags(args: &[String]) -> Result<HashMap<String, String>, String> {
+    let mut flags = HashMap::new();
+    let mut iter = args.iter();
+    while let Some(arg) = iter.next() {
+        let Some(body) = arg.strip_prefix("--") else {
+            return Err(format!("意外的位置参数: {arg}（选项都以 -- 开头）"));
+        };
+        if let Some((key, value)) = body.split_once('=') {
+            flags.insert(key.to_string(), value.to_string());
+        } else if iter
+            .clone()
+            .next()
+            .is_some_and(|next| !next.starts_with("--"))
+        {
+            flags.insert(body.to_string(), iter.next().unwrap().clone());
+        } else {
+            // 布尔开关，如 --set-current
+            flags.insert(body.to_string(), "true".to_string());
+        }
+    }
+    Ok(flags)
+}
+
+fn open_db(flags: &HashMap<String, String>) -> Result<Database, String> {
+    match flags.get("db") {
+        Some(path) => Database::init_at(Path::new(path)),
+        None => Database::init(),
+    }
+    .map_err(|e| format!("打开数据库失败: {e}"))
+}
+
+fn app_of(flags: &HashMap<String, String>) -> String {
+    flags
+        .get("app")
+        .cloned()
+        .unwrap_or_else(|| DEFAULT_APP.to_string())
+}
+
+fn flag<'a>(flags: &'a HashMap<String, String>, key: &str) -> Option<&'a str> {
+    flags.get(key).map(String::as_str)
+}
+
+fn has(flags: &HashMap<String, String>, key: &str) -> bool {
+    flags.contains_key(key)
+}
+
+/// 把 `--flag-key` 写进 env 的 `env-key`；传空字符串则删除该键。
+fn apply_env(
+    env: &mut Map<String, Value>,
+    flags: &HashMap<String, String>,
+    flag_key: &str,
+    env_key: &str,
+) {
+    if let Some(value) = flags.get(flag_key) {
+        if value.is_empty() {
+            env.remove(env_key);
+        } else {
+            env.insert(env_key.to_string(), Value::String(value.clone()));
+        }
+    }
+}
+
+/// 把 `--flag-key` 里的 JSON 写进 settings_config 的 `config-key`；传空字符串则删除该键。
+/// 写入前按表形状校验（节点必须有 name；路由至少有 node/format 之一且 format 合法）。
+fn apply_model_flag(
+    config: &mut Map<String, Value>,
+    flags: &HashMap<String, String>,
+    flag_key: &str,
+    config_key: &str,
+) -> Result<(), String> {
+    let Some(raw) = flags.get(flag_key) else {
+        return Ok(());
+    };
+    if raw.trim().is_empty() {
+        config.remove(config_key);
+        return Ok(());
+    }
+    let value: Value =
+        serde_json::from_str(raw).map_err(|e| format!("--{flag_key} 不是合法 JSON: {e}"))?;
+    match config_key {
+        "modelNodes" => validate_model_nodes(&value, flag_key)?,
+        _ => validate_model_routes(&value, flag_key)?,
+    }
+    config.insert(config_key.to_string(), value);
+    Ok(())
+}
+
+/// 节点表：`[{name, url?, key?}]`；name 必填且不重复，url/key 可省略。
+fn validate_model_nodes(value: &Value, flag_key: &str) -> Result<(), String> {
+    let items = value
+        .as_array()
+        .ok_or_else(|| format!("--{flag_key} 应为节点数组"))?;
+    let mut seen = std::collections::HashSet::new();
+    for (i, item) in items.iter().enumerate() {
+        let obj = item
+            .as_object()
+            .ok_or_else(|| format!("--{flag_key}[{i}] 应为对象"))?;
+        let name = obj
+            .get("name")
+            .and_then(Value::as_str)
+            .map(str::trim)
+            .filter(|s| !s.is_empty())
+            .ok_or_else(|| format!("--{flag_key}[{i}] 缺少非空 name"))?;
+        if !seen.insert(name.to_string()) {
+            return Err(format!("--{flag_key} 节点名重复: {name}"));
+        }
+        for field in ["url", "key"] {
+            if let Some(v) = obj.get(field) {
+                if !v.is_string() {
+                    return Err(format!("--{flag_key}[{i}].{field} 应为字符串"));
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+/// 路由表：`{model: {node?, format?}}`；至少一项；format 取值域与 --api-format 一致；
+/// 模型键不带 `[1m]` 后缀（引擎匹配前会剥掉，带后缀的键永远匹配不上）。
+fn validate_model_routes(value: &Value, flag_key: &str) -> Result<(), String> {
+    let routes = value
+        .as_object()
+        .ok_or_else(|| format!("--{flag_key} 应为对象 {{model: …}}"))?;
+    for (model, route) in routes {
+        if model.trim().is_empty() {
+            return Err(format!("--{flag_key} 存在空模型名"));
+        }
+        if model.to_ascii_lowercase().ends_with("[1m]") {
+            return Err(format!(
+                "--{flag_key} 的键不要带 [1m] 后缀（引擎匹配前会剥掉）: {model}"
+            ));
+        }
+        let obj = route
+            .as_object()
+            .ok_or_else(|| format!("--{flag_key}[{model}] 应为对象"))?;
+        let node = obj.get("node").and_then(Value::as_str).map(str::trim);
+        let fmt = obj.get("format").and_then(Value::as_str).map(str::trim);
+        if node.is_none() && fmt.is_none() {
+            return Err(format!("--{flag_key}[{model}] 至少要指定 node 或 format"));
+        }
+        if node.is_some_and(str::is_empty) {
+            return Err(format!("--{flag_key}[{model}].node 不能为空字符串"));
+        }
+        if let Some(fmt) = fmt {
+            if fmt.is_empty() {
+                return Err(format!("--{flag_key}[{model}].format 不能为空字符串"));
+            }
+            if !crate::proxy::model_route::MODEL_ROUTE_FORMATS.contains(&fmt) {
+                return Err(format!(
+                    "--{flag_key}[{model}].format 未知的接口形态: {fmt}（可选 {}）",
+                    crate::proxy::model_route::MODEL_ROUTE_FORMATS.join("/")
+                ));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// `--api-format` → `meta.apiFormat`（引擎判定上游协议的 SSOT）。
+/// 不传时原样保留已有 meta（update 不洗掉协议声明）。
+fn resolve_meta(
+    existing: Option<&ProviderMeta>,
+    flags: &HashMap<String, String>,
+) -> Result<Option<ProviderMeta>, String> {
+    let mut meta = existing.cloned();
+    if let Some(fmt) = flags.get("api-format") {
+        match fmt.as_str() {
+            "anthropic" | "openai_chat" | "openai_responses" | "gemini_native" => {
+                let mut m = meta.unwrap_or_default();
+                m.api_format = Some(fmt.clone());
+                meta = Some(m);
+            }
+            other => {
+                return Err(format!(
+                    "未知的 --api-format: {other}（可选 anthropic/openai_chat/openai_responses/gemini_native）"
+                ))
+            }
+        }
+    }
+    Ok(meta)
+}
+
+fn unique_id(db: &Database, app: &str, name: &str) -> Result<String, String> {
+    let base = slugify(name);
+    let existing = db.get_provider_ids(app).map_err(|e| e.to_string())?;
+    if !existing.contains(&base) {
+        return Ok(base);
+    }
+    let mut n = 2;
+    loop {
+        let candidate = format!("{base}-{n}");
+        if !existing.contains(&candidate) {
+            return Ok(candidate);
+        }
+        n += 1;
+    }
+}
+
+fn slugify(name: &str) -> String {
+    let mut out = String::new();
+    let mut prev_dash = false;
+    for ch in name.chars() {
+        if ch.is_ascii_alphanumeric() {
+            out.push(ch.to_ascii_lowercase());
+            prev_dash = false;
+        } else if !prev_dash && !out.is_empty() {
+            out.push('-');
+            prev_dash = true;
+        }
+    }
+    while out.ends_with('-') {
+        out.pop();
+    }
+    if out.is_empty() {
+        out.push_str("provider");
+    }
+    out
+}
+
+fn emit(value: &Value) {
+    println!(
+        "{}",
+        serde_json::to_string(value).unwrap_or_else(|_| "{}".to_string())
+    );
+}
