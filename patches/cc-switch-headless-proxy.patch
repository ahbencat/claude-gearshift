+
+    #[test]
+    fn apply_model_flag_rejects_bad_payloads() {
+        let cases: [(&str, &str, &str); 8] = [
+            ("model-nodes", "not-json", "modelNodes"),
+            ("model-nodes", r#"{"name":"a"}"#, "modelNodes"), // 应为数组
+            ("model-nodes", r#"[{"url":"https://a"}]"#, "modelNodes"), // 缺 name
+            (
+                "model-nodes",
+                r#"[{"name":"a"},{"name":"a"}]"#,
+                "modelNodes",
+            ), // 重名
+            ("model-routes", "not-json", "modelRoutes"),
+            ("model-routes", r#"{"m":{}}"#, "modelRoutes"), // 无 node/format
+            ("model-routes", r#"{"m":{"format":"ftp"}}"#, "modelRoutes"), // 未知形态
+            (
+                "model-routes",
+                r#"{"m[1M]":{"format":"anthropic"}}"#,
+                "modelRoutes",
+            ), // 带 [1m]
+        ];
+        for (flag_key, raw, config_key) in cases {
+            let mut flags = HashMap::new();
+            flags.insert(flag_key.to_string(), raw.to_string());
+            let mut config = Map::new();
+            let result = apply_model_flag(&mut config, &flags, flag_key, config_key);
+            assert!(result.is_err(), "应为非法 payload: {flag_key}={raw}");
+            assert!(config.is_empty(), "校验失败时不得写入: {flag_key}={raw}");
+        }
+    }
+}
