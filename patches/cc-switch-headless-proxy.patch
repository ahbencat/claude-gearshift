diff --git a/src-tauri/src/provider_cli.rs b/src-tauri/src/provider_cli.rs
new file mode 100644
index 00000000..5178420f
--- /dev/null
+++ b/src-tauri/src/provider_cli.rs
@@ -0,0 +1,487 @@
+//! `cc-switch-proxy provider` — 在无桌面端的情况下管理 cc-switch DB 里的供应商。
+//!
+//! 复用 cc-switch 自己的 DAO（`Database::save_provider` / `set_current_provider` …），
+//! 因此 schema 与迁移始终与桌面端一致，不需要调用方拼 SQL。供 dd-switch 之类的
+//! 控制器读写供应商，交给本地路由使用。
+//!
+//! 用法（默认 `--app claude`）：
+//!   cc-switch-proxy provider list        [--app claude] [--db PATH]
+//!   cc-switch-proxy provider add         --name N --base-url U --token T
+//!                                        [--model M] [--haiku M] [--sonnet M] [--opus M]
+//!                                        [--id ID] [--set-current]
+//!   cc-switch-proxy provider update      --id ID [同上字段]
+//!   cc-switch-proxy provider delete      --id ID
+//!   cc-switch-proxy provider set-current --id ID
+//!   cc-switch-proxy provider import      --dir DIR [--set-current]
+//!
+//! 所有命令都往 stdout 打印一行 JSON，便于调用方解析。
+
+use crate::app_config::AppType;
+use crate::database::Database;
+use crate::mode::current::{provider_for, Purpose};
+use crate::provider::{Provider, ProviderMeta};
+use serde_json::{json, Map, Value};
+use std::collections::HashMap;
+use std::path::Path;
+use std::str::FromStr;
+
+pub const PROVIDER_HELP: &str = "\
+cc-switch-proxy provider — 管理 cc-switch DB 里的供应商（无桌面端）
+
+用法:
+  cc-switch-proxy provider <list|add|update|delete|set-current|import> [选项]
+
+通用选项:
+  --app <APP>   应用类型，默认 claude
+  --db <PATH>   SQLite 数据库路径，默认 ~/.cc-switch/cc-switch.db
+
+list:
+  列出该应用的所有供应商（含 isCurrent / settingsConfig）。
+
+add / update:
+  --name <N>        显示名（add 必填）
+  --base-url <URL>  上游地址        → ANTHROPIC_BASE_URL
+  --token <T>       凭据            → ANTHROPIC_AUTH_TOKEN
+  --model <M>       默认模型        → ANTHROPIC_MODEL
+  --haiku/--sonnet/--opus <M>       档位模型 → ANTHROPIC_DEFAULT_*_MODEL
+  --api-format <F>                  上游协议声明 → meta.apiFormat
+                                    （anthropic / openai_chat / openai_responses /
+                                    gemini_native；缺省 anthropic，即原样透传）
+  --id <ID>         供应商标识（update 必填；add 省略则按名称生成）
+  --set-current     保存后设为当前供应商
+  传空值（如 --token ''）可清空对应字段。
+
+delete / set-current:
+  --id <ID>         目标供应商标识
+
+import:
+  --dir <DIR>       扫描目录下的 *.json（跳过 sample.json），逐个写入。
+                    文件内容按 Claude 供应商的 {\"env\": {...}} 形状处理。
+  --set-current     导入后把第一个设为当前
+
+输出: 单行 JSON。
+";
+
+const DEFAULT_APP: &str = "claude";
+
+/// 分发 `provider` 子命令（`args` 不含开头的 `provider`）。
+pub fn run(args: &[String]) -> Result<(), String> {
+    let action = args.first().map(String::as_str).unwrap_or("list");
+    let rest: &[String] = args.get(1..).unwrap_or(&[]);
+
+    match action {
+        "-h" | "--help" | "help" => {
+            println!("{PROVIDER_HELP}");
+            Ok(())
+        }
+        "list" => cmd_list(rest),
+        "add" => cmd_upsert(rest, true),
+        "update" => cmd_upsert(rest, false),
+        "delete" => cmd_delete(rest),
+        "set-current" => cmd_set_current(rest),
+        "import" => cmd_import(rest),
+        other => Err(format!(
+            "未知的 provider 子命令: {other}（用 `cc-switch-proxy provider --help`）"
+        )),
+    }
+}
+
+fn cmd_list(args: &[String]) -> Result<(), String> {
+    let flags = parse_flags(args)?;
+    let db = open_db(&flags)?;
+    let app = app_of(&flags);
+
+    let providers = db.get_all_providers(&app).map_err(|e| e.to_string())?;
+    // CLI 语境里 list 的 "current" 是 DB 里的直连指针（代理路由是运行态，见
+    // route_apply），因此走 Purpose::Direct 读指针。
+    let current = provider_for(
+        &db,
+        &AppType::from_str(&app).map_err(|e| e.to_string())?,
+        Purpose::Direct,
+    )
+    .map_err(|e| e.to_string())?;
+    let items: Vec<Value> = providers
+        .values()
+        .map(|p| {
+            json!({
+                "id": p.id,
+                "name": p.name,
+                "settingsConfig": p.settings_config,
+                "apiFormat": p.meta.as_ref().and_then(|m| m.api_format.clone()),
+                "inFailoverQueue": p.in_failover_queue,
+                "isCurrent": current.as_deref() == Some(p.id.as_str()),
+            })
+        })
+        .collect();
+
+    emit(&json!({ "app": app, "current": current, "providers": items }));
+    Ok(())
+}
+
+fn cmd_upsert(args: &[String], is_add: bool) -> Result<(), String> {
+    let flags = parse_flags(args)?;
+    let db = open_db(&flags)?;
+    let app = app_of(&flags);
+
+    let existing = match flags.get("id") {
+        Some(id) => db.get_provider_by_id(id, &app).map_err(|e| e.to_string())?,
+        None => None,
+    };
+
+    let id = match flags.get("id") {
+        Some(id) => id.clone(),
+        None if is_add => {
+            let name = flag(&flags, "name").ok_or("add 需要 --name")?;
+            unique_id(&db, &app, name)?
+        }
+        None => return Err("update 需要 --id".to_string()),
+    };
+
+    let name = flag(&flags, "name")
+        .map(String::from)
+        .or_else(|| existing.as_ref().map(|p| p.name.clone()))
+        .ok_or("add 需要 --name")?;
+
+    // 在现有 env 基础上合并（update 只改传进来的字段）。
+    let mut env = existing
+        .as_ref()
+        .and_then(|p| p.settings_config.get("env"))
+        .and_then(Value::as_object)
+        .cloned()
+        .unwrap_or_default();
+    apply_env(&mut env, &flags, "base-url", "ANTHROPIC_BASE_URL");
+    apply_env(&mut env, &flags, "token", "ANTHROPIC_AUTH_TOKEN");
+    apply_env(&mut env, &flags, "model", "ANTHROPIC_MODEL");
+    apply_env(&mut env, &flags, "haiku", "ANTHROPIC_DEFAULT_HAIKU_MODEL");
+    apply_env(&mut env, &flags, "sonnet", "ANTHROPIC_DEFAULT_SONNET_MODEL");
+    apply_env(&mut env, &flags, "opus", "ANTHROPIC_DEFAULT_OPUS_MODEL");
+
+    // 协议声明进 meta.apiFormat（引擎 SSOT）；update 不传 --api-format 时保留原值。
+    let meta = resolve_meta(
+        existing.as_ref().and_then(|p| p.meta.as_ref()),
+        &flags,
+    )?;
+
+    let settings_config = json!({ "env": Value::Object(env) });
+    let mut provider = Provider::with_id(id.clone(), name, settings_config, None);
+    provider.meta = meta;
+    db.save_provider(&app, &provider)
+        .map_err(|e| e.to_string())?;
+
+    if has(&flags, "set-current") {
+        db.set_current_provider(&app, &id)
+            .map_err(|e| e.to_string())?;
+    }
+
+    // add/更新后的 current 展示同样只读直连指针。
+    let current = provider_for(
+        &db,
+        &AppType::from_str(&app).map_err(|e| e.to_string())?,
+        Purpose::Direct,
+    )
+    .ok()
+    .flatten();
+    emit(&json!({ "ok": true, "app": app, "id": id, "current": current }));
+    Ok(())
+}
+
+fn cmd_delete(args: &[String]) -> Result<(), String> {
+    let flags = parse_flags(args)?;
+    let db = open_db(&flags)?;
+    let app = app_of(&flags);
+    let id = flag(&flags, "id").ok_or("delete 需要 --id")?;
+
+    db.delete_provider(&app, id).map_err(|e| e.to_string())?;
+    emit(&json!({ "ok": true, "app": app, "deleted": id }));
+    Ok(())
+}
+
+fn cmd_set_current(args: &[String]) -> Result<(), String> {
+    let flags = parse_flags(args)?;
+    let db = open_db(&flags)?;
+    let app = app_of(&flags);
+    let id = flag(&flags, "id").ok_or("set-current 需要 --id")?;
+
+    db.set_current_provider(&app, id)
+        .map_err(|e| e.to_string())?;
+    emit(&json!({ "ok": true, "app": app, "current": id }));
+    Ok(())
+}
+
+fn cmd_import(args: &[String]) -> Result<(), String> {
+    let flags = parse_flags(args)?;
+    let db = open_db(&flags)?;
+    let app = app_of(&flags);
+    let dir = flag(&flags, "dir").ok_or("import 需要 --dir")?;
+
+    let mut imported: Vec<String> = Vec::new();
+    let mut errors: Vec<String> = Vec::new();
+
+    let entries = std::fs::read_dir(dir).map_err(|e| format!("读取目录失败 {dir}: {e}"))?;
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if path.extension().and_then(|s| s.to_str()) != Some("json") {
+            continue;
+        }
+        let Some(stem) = path.file_stem().and_then(|s| s.to_str()).map(String::from) else {
+            continue;
+        };
+        if stem == "sample" {
+            continue;
+        }
+        let text = match std::fs::read_to_string(&path) {
+            Ok(text) => text,
+            Err(e) => {
+                errors.push(format!("{stem}: 读取失败: {e}"));
+                continue;
+            }
+        };
+        let value: Value = match serde_json::from_str(&text) {
+            Ok(value) => value,
+            Err(e) => {
+                errors.push(format!("{stem}: JSON 解析失败: {e}"));
+                continue;
+            }
+        };
+        // Claude 供应商就是 {"env": {...}}；如果文件本身就是 env 块，包一层。
+        let settings_config = if value.get("env").is_some() {
+            value
+        } else {
+            json!({ "env": value })
+        };
+        let provider = Provider::with_id(stem.clone(), stem.clone(), settings_config, None);
+        match db.save_provider(&app, &provider) {
+            Ok(()) => imported.push(stem),
+            Err(e) => errors.push(format!("{stem}: {e}")),
+        }
+    }
+
+    if has(&flags, "set-current") {
+        if let Some(first) = imported.first() {
+            db.set_current_provider(&app, first)
+                .map_err(|e| e.to_string())?;
+        }
+    }
+
+    emit(&json!({
+        "ok": errors.is_empty(),
+        "app": app,
+        "imported": imported,
+        "errors": errors,
+    }));
+    Ok(())
+}
+
+// --- 辅助 ---
+
+fn parse_flags(args: &[String]) -> Result<HashMap<String, String>, String> {
+    let mut flags = HashMap::new();
+    let mut iter = args.iter();
+    while let Some(arg) = iter.next() {
+        let Some(body) = arg.strip_prefix("--") else {
+            return Err(format!("意外的位置参数: {arg}（选项都以 -- 开头）"));
+        };
+        if let Some((key, value)) = body.split_once('=') {
+            flags.insert(key.to_string(), value.to_string());
+        } else if iter
+            .clone()
+            .next()
+            .is_some_and(|next| !next.starts_with("--"))
+        {
+            flags.insert(body.to_string(), iter.next().unwrap().clone());
+        } else {
+            // 布尔开关，如 --set-current
+            flags.insert(body.to_string(), "true".to_string());
+        }
+    }
+    Ok(flags)
+}
+
+fn open_db(flags: &HashMap<String, String>) -> Result<Database, String> {
+    match flags.get("db") {
+        Some(path) => Database::init_at(Path::new(path)),
+        None => Database::init(),
+    }
+    .map_err(|e| format!("打开数据库失败: {e}"))
+}
+
+fn app_of(flags: &HashMap<String, String>) -> String {
+    flags
+        .get("app")
+        .cloned()
+        .unwrap_or_else(|| DEFAULT_APP.to_string())
+}
+
+fn flag<'a>(flags: &'a HashMap<String, String>, key: &str) -> Option<&'a str> {
+    flags.get(key).map(String::as_str)
+}
+
+fn has(flags: &HashMap<String, String>, key: &str) -> bool {
+    flags.contains_key(key)
+}
+
+/// 把 `--flag-key` 写进 env 的 `env-key`；传空字符串则删除该键。
+fn apply_env(
+    env: &mut Map<String, Value>,
+    flags: &HashMap<String, String>,
+    flag_key: &str,
+    env_key: &str,
+) {
+    if let Some(value) = flags.get(flag_key) {
+        if value.is_empty() {
+            env.remove(env_key);
+        } else {
+            env.insert(env_key.to_string(), Value::String(value.clone()));
+        }
+    }
+}
+
+/// `--api-format` → `meta.apiFormat`（引擎判定上游协议的 SSOT）。
+/// 不传时原样保留已有 meta（update 不洗掉协议声明）。
+fn resolve_meta(
+    existing: Option<&ProviderMeta>,
+    flags: &HashMap<String, String>,
+) -> Result<Option<ProviderMeta>, String> {
+    let mut meta = existing.cloned();
+    if let Some(fmt) = flags.get("api-format") {
+        match fmt.as_str() {
+            "anthropic" | "openai_chat" | "openai_responses" | "gemini_native" => {
+                let mut m = meta.unwrap_or_default();
+                m.api_format = Some(fmt.clone());
+                meta = Some(m);
+            }
+            other => {
+                return Err(format!(
+                    "未知的 --api-format: {other}（可选 anthropic/openai_chat/openai_responses/gemini_native）"
+                ))
+            }
+        }
+    }
+    Ok(meta)
+}
+
+fn unique_id(db: &Database, app: &str, name: &str) -> Result<String, String> {
+    let base = slugify(name);
+    let existing = db.get_provider_ids(app).map_err(|e| e.to_string())?;
+    if !existing.contains(&base) {
+        return Ok(base);
+    }
+    let mut n = 2;
+    loop {
+        let candidate = format!("{base}-{n}");
+        if !existing.contains(&candidate) {
+            return Ok(candidate);
+        }
+        n += 1;
+    }
+}
+
+fn slugify(name: &str) -> String {
+    let mut out = String::new();
+    let mut prev_dash = false;
+    for ch in name.chars() {
+        if ch.is_ascii_alphanumeric() {
+            out.push(ch.to_ascii_lowercase());
+            prev_dash = false;
+        } else if !prev_dash && !out.is_empty() {
+            out.push('-');
+            prev_dash = true;
+        }
+    }
+    while out.ends_with('-') {
+        out.pop();
+    }
+    if out.is_empty() {
+        out.push_str("provider");
+    }
+    out
+}
+
+fn emit(value: &Value) {
+    println!(
+        "{}",
+        serde_json::to_string(value).unwrap_or_else(|_| "{}".to_string())
+    );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn args(items: &[&str]) -> Vec<String> {
+        items.iter().map(|s| s.to_string()).collect()
+    }
+
+    #[test]
+    fn parse_flags_reads_values_and_booleans() {
+        let flags = parse_flags(&args(&[
+            "--name",
+            "My Provider",
+            "--token=abc",
+            "--set-current",
+            "--db",
+            "/tmp/x.db",
+        ]))
+        .unwrap();
+        assert_eq!(flags.get("name").map(String::as_str), Some("My Provider"));
+        assert_eq!(flags.get("token").map(String::as_str), Some("abc"));
+        assert_eq!(flags.get("set-current").map(String::as_str), Some("true"));
+        assert_eq!(flags.get("db").map(String::as_str), Some("/tmp/x.db"));
+    }
+
+    #[test]
+    fn parse_flags_rejects_positional() {
+        assert!(parse_flags(&args(&["oops"])).is_err());
+    }
+
+    #[test]
+    fn slugify_makes_stable_ids() {
+        assert_eq!(slugify("My Provider"), "my-provider");
+        assert_eq!(slugify("  火山 Ark  "), "ark");
+        assert_eq!(slugify("!!!"), "provider");
+    }
+
+    #[test]
+    fn resolve_meta_sets_api_format() {
+        let flags = parse_flags(&args(&["--api-format", "openai_chat"])).unwrap();
+        let meta = resolve_meta(None, &flags).unwrap();
+        assert_eq!(
+            meta.as_ref().and_then(|m| m.api_format.as_deref()),
+            Some("openai_chat")
+        );
+    }
+
+    #[test]
+    fn resolve_meta_rejects_unknown_format() {
+        let flags = parse_flags(&args(&["--api-format", "ftp"])).unwrap();
+        assert!(resolve_meta(None, &flags).is_err());
+    }
+
+    #[test]
+    fn resolve_meta_keeps_existing_without_flag() {
+        let mut old = ProviderMeta::default();
+        old.api_format = Some("gemini_native".to_string());
+        let flags = parse_flags(&args(&["--name", "x"])).unwrap();
+        let meta = resolve_meta(Some(&old), &flags).unwrap();
+        assert_eq!(
+            meta.as_ref().and_then(|m| m.api_format.as_deref()),
+            Some("gemini_native")
+        );
+        // 既无旧值又不传 flag：保持 None，不凭空造出空 meta。
+        let flags = parse_flags(&args(&["--name", "x"])).unwrap();
+        assert!(resolve_meta(None, &flags).unwrap().is_none());
+    }
+
+    #[test]
+    fn apply_env_writes_and_clears() {
+        let mut env = Map::new();
+        let flags = parse_flags(&args(&["--token", "", "--base-url", "https://x"])).unwrap();
+        apply_env(&mut env, &flags, "base-url", "ANTHROPIC_BASE_URL");
+        apply_env(&mut env, &flags, "token", "ANTHROPIC_AUTH_TOKEN");
+        assert_eq!(
+            env.get("ANTHROPIC_BASE_URL").and_then(Value::as_str),
+            Some("https://x")
+        );
+        assert!(env.get("ANTHROPIC_AUTH_TOKEN").is_none());
+    }
+}
